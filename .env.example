# MotifCue private backend
MOTIFCUE_API_BASE_URL=https://motifcue-env-staging-syftware.vercel.app
ANTON_INTERNAL_API_KEY=replace-with-the-same-random-secret-used-by-motifcue

# Required only when the target Vercel deployment has Deployment Protection enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Worker
POLL_INTERVAL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=45
MEDIA_PAGE_SIZE=20
MAX_MEDIA_ITEMS=100
MEDIA_ANALYSIS_CONCURRENCY=2
MAX_MEDIA_BYTES=52428800
CLEANUP_MEDIA_AFTER_SUCCESS=true
DATA_DIRECTORY=./data
REPORT_DIRECTORY=./reports
DATABASE_URL=sqlite:///./data/anton.db
LOG_LEVEL=INFO

# Local Llama through an OpenAI-compatible server (Ollama defaults shown)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=llama3.2:latest
LLM_VISION_MODEL=llama3.2-vision:11b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Report
REPORT_LANGUAGE=en
REPORT_BRAND_NAME=MotifCue

# Storage: local_only, local, or s3
# local_only leaves the PDF in REPORT_DIRECTORY and requires no public URL.
# Local writes the PDF to REPORT_DIRECTORY. REPORT_PUBLIC_BASE_URL must expose
# that directory over HTTPS so MotifCue can save a customer-accessible URL.
REPORT_STORAGE_DRIVER=local_only
REPORT_PUBLIC_BASE_URL=https://reports.example.com

# S3-compatible storage (only needed when REPORT_STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
