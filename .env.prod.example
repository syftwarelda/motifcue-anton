# Copy this file to .env.prod and fill it with production values.
# Never commit the resulting .env.prod file.

MOTIFCUE_API_BASE_URL=https://motifcue.vercel.app
ANTON_INTERNAL_API_KEY=replace-with-the-production-internal-api-secret
VERCEL_AUTOMATION_BYPASS_SECRET=

POLL_INTERVAL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=45
MEDIA_PAGE_SIZE=20
MAX_MEDIA_ITEMS=100
MEDIA_ANALYSIS_CONCURRENCY=2
MAX_MEDIA_BYTES=52428800
CLEANUP_MEDIA_AFTER_SUCCESS=true
DATA_DIRECTORY=./data
REPORT_DIRECTORY=./reports
DATABASE_URL=sqlite:///./data/anton.db
LOG_LEVEL=INFO

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=llama3.2:latest
LLM_VISION_MODEL=llama3.2-vision:11b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

REPORT_LANGUAGE=en
REPORT_BRAND_NAME=MotifCue
REPORT_STORAGE_DRIVER=local_only
REPORT_PUBLIC_BASE_URL=https://reports.example.com

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
